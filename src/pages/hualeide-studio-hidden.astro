---
const apiPrefix = `${import.meta.env.BASE_URL.replace(/\/+$/, "")}/__firefly/`;
if (!import.meta.env.DEV) return Astro.redirect('/404/');
---
<html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>Studio</title><style>body{margin:0;background:#0f1419;color:#e8eef7;font-family:system-ui}.w{max-width:54rem;margin:0 auto;padding:1rem}input,textarea,select,button{font:inherit}label{display:block;font-size:.78rem;color:#9fb1cb;margin:.45rem 0 .2rem}input,textarea,select{width:100%;padding:.45rem;border:1px solid #2d3a4f;border-radius:.4rem;background:#0f1419;color:#e8eef7}.row{display:flex;gap:.5rem;flex-wrap:wrap}.btn{padding:.45rem .8rem;border-radius:.4rem;border:1px solid #2d3a4f;background:#1a2332;color:#e8eef7;cursor:pointer}.ok{background:#38bdf8;color:#03121a;border:none;font-weight:600}.sec{display:none;border:1px solid #2d3a4f;background:#1a2332;border-radius:.7rem;padding:1rem}.sec.on{display:block}.tabs{display:flex;gap:.5rem;margin:.8rem 0}.tab.on{border-color:#38bdf8}#st{margin-top:.6rem;font-size:.82rem}</style></head><body><div class="w"><h3>隐秘内容管理台</h3><p><a href="/" style="color:#38bdf8">返回首页</a></p><div class="tabs"><button class="btn tab on" data-k="ann">公告</button><button class="btn tab" data-k="home">主页</button><button class="btn tab" data-k="post">文章</button></div><section id="ann" class="sec on"><label>标题</label><input id="annTitle"/><label>正文</label><textarea id="annContent" rows="4"></textarea><label>链接文字</label><input id="annText"/><label>链接URL</label><input id="annUrl"/><button id="saveAnn" class="btn ok">保存公告</button></section><section id="home" class="sec"><label>站点标题</label><input id="siteTitle"/><label>站点副标题</label><input id="siteSub"/><label>描述</label><textarea id="siteDesc" rows="3"></textarea><label>横幅主标题</label><input id="bannerTitle"/><label>横幅副标题（每行一句）</label><textarea id="bannerSubs" rows="5"></textarea><button id="saveHome" class="btn ok">保存主页</button></section><section id="post" class="sec"><label>文章文件</label><select id="postSel"></select><div class="row"><button id="refreshPost" class="btn">刷新</button><button id="newPost" class="btn">新建</button></div><label>标题</label><input id="postTitle"/><label>日期</label><input id="postDate"/><label>分类</label><input id="postCat"/><label>标签</label><input id="postTags"/><label>摘要</label><input id="postDesc"/><label><input type="checkbox" id="postDraft"/> 草稿</label><label><input type="checkbox" id="postPinned"/> 置顶</label><label>正文</label><textarea id="postBody" rows="12"></textarea><button id="savePost" class="btn ok">保存文章</button></section><div id="st"></div></div><script is:inline define:vars={{apiPrefix}}>
(()=>{const $=id=>document.getElementById(id);const tabs=[...document.querySelectorAll('.tab')];const st=(m,ok)=>{$('st').textContent=m||'';$('st').style.color=ok===false?'#f87171':'#34d399'};const api=s=>apiPrefix+s;const J=(u,o)=>fetch(u,o).then(r=>r.text().then(t=>{const j=JSON.parse(t);if(!r.ok&&j.error)throw new Error(j.error);return j}));tabs.forEach(b=>b.onclick=()=>{tabs.forEach(x=>x.classList.remove('on'));b.classList.add('on');['ann','home','post'].forEach(k=>$(k).classList.toggle('on',k===b.dataset.k));});function fill(o){$('annTitle').value=o.announcement?.title||'';$('annContent').value=o.announcement?.content||'';$('annText').value=o.announcement?.linkText||'';$('annUrl').value=o.announcement?.linkUrl||'';$('siteTitle').value=o.homepage?.siteTitle||'';$('siteSub').value=o.homepage?.siteSubtitle||'';$('siteDesc').value=o.homepage?.siteDescription||'';$('bannerTitle').value=o.homepage?.bannerTitle||'';$('bannerSubs').value=(o.homepage?.bannerSubtitles||[]).join('\n');}
function list(){return J(api('post-list/')).then(j=>{const s=$('postSel');const cur=s.value;s.innerHTML='<option value="">--</option>';(j.files||[]).forEach(f=>{const o=document.createElement('option');o.value=f;o.textContent=f;s.appendChild(o)});if(cur)s.value=cur;});}
function loadPost(p){if(!p)return;J(api('post-read/?path='+encodeURIComponent(p))).then(j=>{const d=j.data||{};$('postTitle').value=d.title||'';$('postDate').value=d.published||'';$('postCat').value=d.category||'';$('postTags').value=(d.tags||[]).join(', ');$('postDesc').value=d.description||'';$('postDraft').checked=!!d.draft;$('postPinned').checked=!!d.pinned;$('postBody').value=j.body||'';st('文章已加载',true)}).catch(e=>st(e.message,false));}
$('postSel').onchange=e=>loadPost(e.target.value);$('refreshPost').onclick=()=>list().then(()=>st('列表已刷新',true));$('newPost').onclick=()=>{const slug=prompt('slug(英文/数字/_-)');if(!slug||!/^[a-zA-Z0-9_-]+$/.test(slug))return;const title=prompt('标题',slug)||slug;J(api('post-create/'),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({slug,title,format:'md'})}).then(()=>list().then(()=>{$('postSel').value=slug+'.md';loadPost(slug+'.md')})).catch(e=>st(e.message,false));};
$('saveAnn').onclick=()=>J(api('announcement-save/'),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({title:$('annTitle').value,content:$('annContent').value,linkText:$('annText').value,linkUrl:$('annUrl').value})}).then(j=>st(j.message||'公告已保存',true)).catch(e=>st(e.message,false));
$('saveHome').onclick=()=>{const bannerSubtitles=$('bannerSubs').value.split(/\r?\n/).map(s=>s.trim()).filter(Boolean);J(api('homepage-save/'),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({siteTitle:$('siteTitle').value,siteSubtitle:$('siteSub').value,siteDescription:$('siteDesc').value,bannerTitle:$('bannerTitle').value,bannerSubtitles})}).then(j=>st(j.message||'主页已保存',true)).catch(e=>st(e.message,false));};
$('savePost').onclick=()=>{const path=$('postSel').value;if(!path)return st('先选文章',false);const tags=$('postTags').value.split(/[,，]/).map(s=>s.trim()).filter(Boolean);J(api('post-save/'),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({path,title:$('postTitle').value,published:$('postDate').value,description:$('postDesc').value,category:$('postCat').value,tags,draft:$('postDraft').checked,pinned:$('postPinned').checked,body:$('postBody').value})}).then(j=>st(j.message||'文章已保存',true)).catch(e=>st(e.message,false));};
J(api('content-overview/')).then(fill).then(list).then(()=>st('就绪',true)).catch(e=>st(e.message,false));})();
</script></body></html>
