---
/**
 * 仅开发环境：编辑模式 — 源码路径提示、布局变量预览、主内容区高亮（不写入文件）。
 */
interface Props {
	pathname: string;
	postSlug?: string;
}

const { pathname, postSlug } = Astro.props;
const isDev = import.meta.env.DEV;
const baseTrim = import.meta.env.BASE_URL.replace(/\/+$/, "");
const fireflyApiPrefix = `${baseTrim}/__firefly/`;
---

{
	isDev && (
		<div
			id="firefly-dev-edit-root"
			class="pointer-events-none fixed bottom-5 right-5 z-[99999] font-sans text-[13px] leading-normal text-neutral-800 dark:text-neutral-100"
			data-pathname={pathname}
			data-post-slug={postSlug ?? ""}
		>
			<div class="pointer-events-auto flex flex-col items-end gap-2">
				<button
					type="button"
					id="firefly-dev-edit-fab"
					class="pointer-events-auto rounded-full bg-sky-600 px-4 py-2.5 font-medium text-white shadow-lg hover:bg-sky-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-300"
				>
					编辑模式
				</button>
				<div
					id="firefly-dev-edit-panel"
					class="hidden w-[min(22rem,calc(100vw-2.5rem))] max-h-[min(78vh,32rem)] overflow-y-auto rounded-2xl border border-black/10 bg-white/95 p-4 shadow-2xl backdrop-blur-md dark:border-white/15 dark:bg-neutral-900/95"
				>
					<div class="mb-3 flex items-center justify-between gap-2 border-b border-black/10 pb-2 dark:border-white/10">
						<span class="font-semibold text-sky-700 dark:text-sky-400">开发 · 编辑模式</span>
						<button
							type="button"
							id="firefly-dev-edit-close"
							class="rounded-lg px-2 py-1 text-xs text-neutral-500 hover:bg-black/5 dark:hover:bg-white/10"
						>
							收起
						</button>
					</div>
					<p class="mb-3 text-xs text-neutral-600 dark:text-neutral-400">
						布局圆角等为<strong>仅本地预览</strong>；侧栏<strong>公告</strong>可在开启内联编辑后改文案，并用下方按钮<strong>保存到
						announcementConfig.ts</strong>（仅 dev）。
					</p>

					<label class="mb-3 flex cursor-pointer items-center gap-2 text-xs">
						<input id="firefly-dev-edit-highlight" type="checkbox" class="rounded border-neutral-400" />
						<span>高亮主内容区版块（悬停看虚线框）</span>
					</label>

					<div
						class="mb-3 rounded-xl border border-emerald-500/25 bg-emerald-500/5 p-3 dark:border-emerald-400/20 dark:bg-emerald-500/10"
					>
						<div class="mb-2 text-xs font-medium text-emerald-800 dark:text-emerald-200">公告（侧栏）</div>
						<label class="mb-2 flex cursor-pointer items-start gap-2 text-[11px] text-neutral-700 dark:text-neutral-300">
							<input id="firefly-dev-edit-inline-announce" type="checkbox" class="mt-0.5 rounded border-neutral-400" />
							<span>开启内联编辑（直接改标题、正文、「了解更多」按钮上的字）</span>
						</label>
						<label class="mb-2 block text-[11px] text-neutral-600 dark:text-neutral-400">
							<span class="mb-0.5 block">链接 URL（保存时写入配置；内联编辑时链接不可点以免误触）</span>
							<input
								id="firefly-dev-announce-url"
								type="text"
								class="w-full rounded-lg border border-black/15 bg-white/90 px-2 py-1.5 text-xs text-neutral-800 shadow-sm dark:border-white/15 dark:bg-neutral-950/90 dark:text-neutral-100"
								placeholder="/about/"
							/>
						</label>
						<button
							type="button"
							id="firefly-dev-announce-save"
							class="w-full rounded-lg bg-emerald-600 px-3 py-2 text-xs font-medium text-white hover:bg-emerald-700"
						>
							保存公告到 src/config/announcementConfig.ts
						</button>
					</div>

					<div
						class="mb-3 rounded-xl border border-sky-500/25 bg-sky-500/5 p-3 dark:border-sky-400/20 dark:bg-sky-500/10"
					>
						<div class="mb-1 text-xs font-medium text-sky-900 dark:text-sky-100">文章（src/content/posts）</div>
						<p class="mb-2 text-[11px] leading-snug text-neutral-600 dark:text-neutral-400">
							与公告类似，仅在 <strong>npm run dev</strong> 下可用。新建只支持<strong>单层
							slug</strong>（如 <code class="rounded bg-black/5 px-1 dark:bg-white/10">my-post</code>）；子目录里的文章请在删除框里选路径删除。
						</p>
						<label class="mb-0.5 block text-[11px] text-neutral-600 dark:text-neutral-400">
							slug（不含后缀，仅英文/数字/<wbr />_<wbr />-，如 my-new-post）
						</label>
						<input
							id="firefly-dev-post-slug"
							type="text"
							class="mb-2 w-full rounded-lg border border-black/15 bg-white/90 px-2 py-1.5 text-xs text-neutral-800 dark:border-white/15 dark:bg-neutral-950/90 dark:text-neutral-100"
							placeholder="my-new-post"
							autocomplete="off"
						/>
						<label class="mb-0.5 block text-[11px] text-neutral-600 dark:text-neutral-400">标题（可空，默认同 slug）</label>
						<input
							id="firefly-dev-post-title"
							type="text"
							class="mb-2 w-full rounded-lg border border-black/15 bg-white/90 px-2 py-1.5 text-xs text-neutral-800 dark:border-white/15 dark:bg-neutral-950/90 dark:text-neutral-100"
							placeholder=""
							autocomplete="off"
						/>
						<label class="mb-0.5 block text-[11px] text-neutral-600 dark:text-neutral-400">格式</label>
						<select
							id="firefly-dev-post-format"
							class="mb-2 w-full rounded-lg border border-black/15 bg-white/90 px-2 py-1.5 text-xs text-neutral-800 dark:border-white/15 dark:bg-neutral-950/90 dark:text-neutral-100"
						>
							<option value="md">Markdown（.md）</option>
							<option value="mdx">MDX（.mdx）</option>
						</select>
						<button
							type="button"
							id="firefly-dev-post-create"
							class="mb-3 w-full rounded-lg bg-sky-600 px-3 py-2 text-xs font-medium text-white hover:bg-sky-700"
						>
							创建文章文件
						</button>
						<div class="mb-1 text-[11px] font-medium text-neutral-700 dark:text-neutral-300">删除已有</div>
						<select
							id="firefly-dev-post-delete-select"
							class="mb-2 w-full rounded-lg border border-black/15 bg-white/90 px-2 py-1.5 text-xs text-neutral-800 dark:border-white/15 dark:bg-neutral-950/90 dark:text-neutral-100"
						>
							<option value="">— 先刷新列表 —</option>
						</select>
						<button
							type="button"
							id="firefly-dev-post-delete"
							class="mb-2 w-full rounded-lg border border-red-300 bg-red-50 px-3 py-2 text-xs font-medium text-red-800 hover:bg-red-100 dark:border-red-800/60 dark:bg-red-950/40 dark:text-red-100 dark:hover:bg-red-900/50"
						>
							删除所选（不可恢复）
						</button>
						<button
							type="button"
							id="firefly-dev-post-refresh-list"
							class="w-full rounded-lg bg-neutral-200/90 px-2 py-1.5 text-[11px] font-medium text-neutral-800 hover:bg-neutral-300 dark:bg-neutral-700 dark:text-neutral-100 dark:hover:bg-neutral-600"
						>
							刷新文章列表
						</button>
					</div>

					<div class="mb-3">
						<div class="mb-1 text-xs font-medium text-neutral-700 dark:text-neutral-300">推测源码（点击复制）</div>
						<ul id="firefly-dev-edit-paths" class="space-y-1.5 text-[11px] text-neutral-600 dark:text-neutral-400" />
					</div>

					<div class="mb-2 text-xs font-medium text-neutral-700 dark:text-neutral-300">布局预览（仅当前浏览器）</div>
					<label class="mb-1 flex items-center justify-between gap-2 text-[11px] text-neutral-600 dark:text-neutral-400">
						<span>圆角 (--radius-large)</span>
						<span id="firefly-dev-edit-radius-val" class="tabular-nums text-neutral-500" />
					</label>
					<input
						id="firefly-dev-edit-radius"
						type="range"
						min="6"
						max="40"
						step="1"
						class="mb-3 w-full accent-sky-600"
					/>
					<div class="flex flex-wrap gap-2">
						<button
							type="button"
							id="firefly-dev-edit-layout-reset"
							class="rounded-lg bg-neutral-200/90 px-2.5 py-1.5 text-xs font-medium text-neutral-800 hover:bg-neutral-300 dark:bg-neutral-700 dark:text-neutral-100 dark:hover:bg-neutral-600"
						>
							重置布局预览
						</button>
						<button
							type="button"
							id="firefly-dev-edit-open-float"
							class="rounded-lg bg-neutral-200/90 px-2.5 py-1.5 text-xs font-medium text-neutral-800 hover:bg-neutral-300 dark:bg-neutral-700 dark:text-neutral-100 dark:hover:bg-neutral-600"
						>
							打开悬浮控件
						</button>
					</div>
					<p class="mt-3 text-[10px] leading-snug text-neutral-500 dark:text-neutral-500">
						站点/侧栏/导航：src/config/*.ts；全局样式：src/styles/main.css 等。Swup
						切换页面后若路径提示不准，可关开一次本面板刷新。
					</p>
				</div>
			</div>
		</div>
	)
}

{
	isDev && (
		<style is:global>
			html.firefly-dev-edit-highlight #content-wrapper > * {
				position: relative;
				transition: outline 0.12s ease;
			}
			html.firefly-dev-edit-highlight #content-wrapper > *:hover {
				outline: 2px dashed rgb(14 165 233 / 0.65);
				outline-offset: 4px;
			}
			html.firefly-dev-inline-edit-announce [data-firefly-editable] {
				outline: 2px dashed rgb(16 185 129 / 0.75);
				outline-offset: 3px;
				border-radius: 4px;
			}
			html.firefly-dev-inline-edit-announce widget-layout[data-id="announcement"] a[data-firefly-editable-link="1"] {
				pointer-events: none;
			}
			html.firefly-dev-inline-edit-announce widget-layout[data-id="announcement"] button[aria-label] {
				pointer-events: none;
			}
		</style>
	)
}

{
	isDev && (
		<script is:inline define:vars={{ fireflyApiPrefix }}>
			(function () {
				var root = document.getElementById("firefly-dev-edit-root");
				if (!root) return;
				/** 防止内联脚本被重复执行时叠加多个 click（会表现为点按钮面板闪一下就关 / 点不开） */
				if (root.getAttribute("data-firefly-dev-edit-inited") === "1") return;
				root.setAttribute("data-firefly-dev-edit-inited", "1");

				function fireflyUrl(subpath) {
					var p = String(subpath || "");
					if (p.charAt(0) === "/") p = p.slice(1);
					return fireflyApiPrefix + p;
				}

				var fab = document.getElementById("firefly-dev-edit-fab");
				var panel = document.getElementById("firefly-dev-edit-panel");
				var closeBtn = document.getElementById("firefly-dev-edit-close");
				var pathList = document.getElementById("firefly-dev-edit-paths");
				var hl = document.getElementById("firefly-dev-edit-highlight");
				var radius = document.getElementById("firefly-dev-edit-radius");
				var radiusVal = document.getElementById("firefly-dev-edit-radius-val");
				var resetBtn = document.getElementById("firefly-dev-edit-layout-reset");
				var floatBtn = document.getElementById("firefly-dev-edit-open-float");
				var inlineAnnounce = document.getElementById("firefly-dev-edit-inline-announce");
				var announceUrl = document.getElementById("firefly-dev-announce-url");
				var announceSave = document.getElementById("firefly-dev-announce-save");
				var postSlugInp = document.getElementById("firefly-dev-post-slug");
				var postTitleInp = document.getElementById("firefly-dev-post-title");
				var postFormatSel = document.getElementById("firefly-dev-post-format");
				var postCreateBtn = document.getElementById("firefly-dev-post-create");
				var postDeleteSelect = document.getElementById("firefly-dev-post-delete-select");
				var postDeleteBtn = document.getElementById("firefly-dev-post-delete");
				var postRefreshBtn = document.getElementById("firefly-dev-post-refresh-list");
				if (!fab || !panel || !pathList || !hl || !radius || !radiusVal || !closeBtn) return;

				var STORAGE_LAYOUT = "firefly-dev-edit-layout";
				var STORAGE_HIGHLIGHT = "firefly-dev-edit-highlight";
				var STORAGE_INLINE_ANNOUNCE = "firefly-dev-edit-inline-announce";

				function pathnameNow() {
					return root.getAttribute("data-pathname") || window.location.pathname;
				}
				function postSlugNow() {
					return root.getAttribute("data-post-slug") || "";
				}

				function syncPathFromUrl() {
					try {
						root.setAttribute("data-pathname", window.location.pathname);
					} catch (e) {}
				}

				function guessLines() {
					var p = (pathnameNow() || "/").replace(/\/+$/, "") || "/";
					var slug = postSlugNow();
					var lines = [];
					if (slug) {
						lines.push("src/content/posts/" + slug + ".md");
						lines.push("src/content/posts/" + slug + ".mdx");
						lines.push("（文章页）布局：src/layouts/MainGridLayout.astro、src/layouts/Layout.astro");
						lines.push("侧栏公告：src/config/announcementConfig.ts");
						return lines;
					}
					if (p === "/" || p === "") {
						lines.push("首页：src/pages/index.astro");
						lines.push("站点：src/config/siteConfig.ts、navBarConfig.ts、sidebarConfig.ts");
						lines.push("侧栏公告：src/config/announcementConfig.ts");
						return lines;
					}
					if (p.indexOf("/gallery") === 0) {
						lines.push("相册配置：src/config/galleryConfig.ts");
						lines.push("相册图片：public/gallery/<相册 id>/");
						return lines;
					}
					if (p.indexOf("/about") === 0) {
						lines.push("关于页内容：src/content/spec/about.md");
						lines.push("页面壳：src/pages/about/ 或 src/pages/[...]（按你仓库实际）");
						return lines;
					}
					if (p.indexOf("/friends") === 0) {
						lines.push("友链：src/content/spec/friends.mdx");
						return lines;
					}
					if (p.indexOf("/guestbook") === 0) {
						lines.push("留言板：src/content/spec/guestbook.md");
						return lines;
					}
					if (p.indexOf("/posts") === 0) {
						var m = p.match(/\/posts\/([^/]+)/);
						if (m && m[1]) {
							var s = m[1];
							lines.push("src/content/posts/" + s + ".md");
							lines.push("src/content/posts/" + s + ".mdx");
							lines.push("新建/删文章：本面板「文章」区块（仅 dev）");
						} else {
							lines.push("文章列表：src/pages/posts/ 下对应 .astro");
							lines.push("新建/删文章：本面板「文章」区块（仅 dev）");
						}
						return lines;
					}
					lines.push("在 src/pages/ 中按 URL 查找同名 .astro");
					lines.push("侧栏公告：src/config/announcementConfig.ts");
					lines.push("当前路径：" + pathnameNow());
					return lines;
				}

				function renderPaths() {
					pathList.innerHTML = "";
					guessLines().forEach(function (line) {
						var li = document.createElement("li");
						var btn = document.createElement("button");
						btn.type = "button";
						btn.className =
							"w-full break-all rounded-md px-2 py-1.5 text-left hover:bg-sky-500/10 dark:hover:bg-sky-400/10";
						btn.textContent = line;
						btn.addEventListener("click", function () {
							navigator.clipboard.writeText(line).then(
								function () {
									btn.textContent = "已复制：" + line;
									setTimeout(function () {
										btn.textContent = line;
									}, 1400);
								},
								function () {
									prompt("复制路径", line);
								},
							);
						});
						li.appendChild(btn);
						pathList.appendChild(li);
					});
				}

				function applyHighlight(on) {
					if (on) {
						document.documentElement.classList.add("firefly-dev-edit-highlight");
					} else {
						document.documentElement.classList.remove("firefly-dev-edit-highlight");
					}
					try {
						sessionStorage.setItem(STORAGE_HIGHLIGHT, on ? "1" : "0");
					} catch (e) {}
				}

				function pxToRem(px) {
					return (Number(px) / 16).toFixed(2) + "rem";
				}

				function applyRadius(px) {
					var rem = pxToRem(px);
					document.documentElement.style.setProperty("--radius-large", rem);
					radiusVal.textContent = rem;
					try {
						var o = JSON.parse(sessionStorage.getItem(STORAGE_LAYOUT) || "{}");
						o.radiusPx = px;
						sessionStorage.setItem(STORAGE_LAYOUT, JSON.stringify(o));
					} catch (e) {}
				}

				function loadLayout() {
					try {
						var o = JSON.parse(sessionStorage.getItem(STORAGE_LAYOUT) || "{}");
						if (o.radiusPx != null) {
							radius.value = String(o.radiusPx);
							applyRadius(o.radiusPx);
						} else {
							radius.value = "16";
							radiusVal.textContent = "拖动后预览";
						}
					} catch (e) {
						radius.value = "16";
						radiusVal.textContent = "拖动后预览";
					}
				}

				function resetLayout() {
					document.documentElement.style.removeProperty("--radius-large");
					radiusVal.textContent = "";
					try {
						sessionStorage.removeItem(STORAGE_LAYOUT);
					} catch (e) {}
					radius.value = "16";
				}

				function syncAnnouncementUrlInput() {
					if (!announceUrl) return;
					var w = document.querySelector('widget-layout[data-id="announcement"]');
					var a =
						(w && w.querySelector('a[data-firefly-editable-link="1"]')) ||
						(w && w.querySelector("a.btn-regular"));
					if (a) announceUrl.value = a.getAttribute("href") || "";
				}

				function collectAnnouncementPayload() {
					var root = document.querySelector('widget-layout[data-id="announcement"]');
					if (!root) return null;
					var titleEl = root.querySelector('[data-firefly-editable="announcement-title"]');
					var contentEl = root.querySelector('[data-firefly-editable="announcement-content"]');
					var linkTextEl = root.querySelector('[data-firefly-editable="announcement-link-text"]');
					var linkA =
						root.querySelector('a[data-firefly-editable-link="1"]') || root.querySelector("a.btn-regular");
					var out = {};
					out.title = titleEl ? titleEl.textContent.replace(/\s+/g, " ").trim() : "";
					out.content = contentEl ? contentEl.textContent.replace(/\s+/g, " ").trim() : "";
					var urlIn = announceUrl ? announceUrl.value.trim() : "";
					if (linkTextEl || linkA) {
						out.linkText = linkTextEl ? linkTextEl.textContent.replace(/\s+/g, " ").trim() : "";
						out.linkUrl = urlIn || (linkA ? (linkA.getAttribute("href") || "").trim() : "");
					}
					return out;
				}

				function applyInlineAnnounce(on) {
					if (on) {
						document.documentElement.classList.add("firefly-dev-inline-edit-announce");
					} else {
						document.documentElement.classList.remove("firefly-dev-inline-edit-announce");
					}
					var w = document.querySelector('widget-layout[data-id="announcement"]');
					if (w) {
						w.querySelectorAll("[data-firefly-editable]").forEach(function (el) {
							if (on) el.setAttribute("contenteditable", "true");
							else el.removeAttribute("contenteditable");
						});
					}
					if (on) syncAnnouncementUrlInput();
					try {
						sessionStorage.setItem(STORAGE_INLINE_ANNOUNCE, on ? "1" : "0");
					} catch (e) {}
				}

				function refreshInlineAnnounceAfterNav() {
					if (!inlineAnnounce || !inlineAnnounce.checked) return;
					var w = document.querySelector('widget-layout[data-id="announcement"]');
					if (!w) return;
					document.documentElement.classList.add("firefly-dev-inline-edit-announce");
					w.querySelectorAll("[data-firefly-editable]").forEach(function (el) {
						el.setAttribute("contenteditable", "true");
					});
					syncAnnouncementUrlInput();
				}

				function parseDevJsonText(t) {
					try {
						return JSON.parse(t);
					} catch (err) {
						var hint =
							t.indexOf("<!DOCTYPE") === 0
								? "（返回了 HTML 而非 JSON：请用 npm run dev 启动站点，勿用 astro preview；确认存在 src/middleware.ts；请求路径须带尾斜杠，且与 astro.config 的 base 一致。）"
								: "";
						throw new Error((t && t.slice ? t.slice(0, 160) : "") + hint);
					}
				}

				function refreshPostList() {
					if (!postDeleteSelect) return;
					fetch(fireflyUrl("post-list/"))
						.then(function (r) {
							return r.text().then(function (t) {
								return parseDevJsonText(t);
							});
						})
						.then(function (j) {
							if (!j || !j.ok || !j.files) {
								alert((j && j.error) || "无法加载文章列表");
								return;
							}
							postDeleteSelect.innerHTML = "";
							var opt0 = document.createElement("option");
							opt0.value = "";
							opt0.textContent = "— 选择要删除的文件 —";
							postDeleteSelect.appendChild(opt0);
							j.files.forEach(function (f) {
								var opt = document.createElement("option");
								opt.value = f;
								opt.textContent = f;
								postDeleteSelect.appendChild(opt);
							});
						})
						.catch(function (e) {
							alert("加载文章列表失败：" + (e && e.message ? e.message : String(e)));
						});
				}

				fab.addEventListener("click", function () {
					panel.classList.toggle("hidden");
					if (!panel.classList.contains("hidden")) {
						syncPathFromUrl();
						renderPaths();
						syncAnnouncementUrlInput();
						refreshPostList();
					}
				});
				closeBtn.addEventListener("click", function () {
					panel.classList.add("hidden");
				});

				hl.addEventListener("change", function () {
					applyHighlight(hl.checked);
				});

				radius.addEventListener("input", function () {
					applyRadius(Number(radius.value));
				});

				if (resetBtn) {
					resetBtn.addEventListener("click", function () {
						resetLayout();
					});
				}

				if (floatBtn) {
					floatBtn.addEventListener("click", function () {
						var el = document.getElementById("display-settings-switch");
						if (el && el.click) el.click();
						else alert("未找到显示设置按钮：请在导航栏找「显示设置」图标。");
					});
				}

				if (inlineAnnounce) {
					inlineAnnounce.addEventListener("change", function () {
						applyInlineAnnounce(inlineAnnounce.checked);
					});
				}

				if (announceSave) {
					announceSave.addEventListener("click", function () {
						var payload = collectAnnouncementPayload();
						if (!payload) {
							alert("当前页没有侧栏公告组件。请在侧栏配置中启用公告，并打开带侧栏的页面后再试。");
							return;
						}
						fetch(fireflyUrl("announcement-save/"), {
							method: "POST",
							headers: { "Content-Type": "application/json" },
							body: JSON.stringify(payload),
						})
							.then(function (r) {
								return r.text().then(function (t) {
									try {
										return { res: r, json: JSON.parse(t) };
									} catch (err) {
										var hint =
											t.indexOf("<!DOCTYPE") === 0
												? "（服务器返回了 HTML 而非 JSON：请用 npm run dev；确认 src/middleware.ts；URL 为「base + __firefly/announcement-save/」且带尾斜杠。）"
												: "";
										throw new Error((t && t.slice ? t.slice(0, 160) : "") + hint);
									}
								});
							})
							.then(function (o) {
								var j = o.json;
								if (j.ok) {
									alert(j.message || "已保存");
									window.location.reload();
								} else alert(j.error || "保存失败");
							})
							.catch(function (e) {
								alert("保存请求失败：" + (e && e.message ? e.message : String(e)));
							});
					});
				}

				if (postCreateBtn && postSlugInp) {
					postCreateBtn.addEventListener("click", function () {
						var slug = postSlugInp.value.trim().replace(/\.(md|mdx)$/i, "");
						if (!slug) {
							alert("请填写 slug（不含 .md 后缀）");
							return;
						}
						if (!/^[a-zA-Z0-9_-]+$/.test(slug)) {
							alert(
								"slug 只能使用英文字母、数字、下划线和连字符（例如 my-post），不能使用中文或空格。\n若仍报错「返回了 HTML」，请结束所有 dev 进程后重新执行 npm run dev（不要用 astro preview），并确认项目根目录存在 src/middleware.ts。",
							);
							return;
						}
						var body = {
							slug: slug,
							title: postTitleInp ? postTitleInp.value.trim() : "",
							format: postFormatSel && postFormatSel.value === "mdx" ? "mdx" : "md",
						};
						fetch(fireflyUrl("post-create/"), {
							method: "POST",
							headers: { "Content-Type": "application/json" },
							body: JSON.stringify(body),
						})
							.then(function (r) {
								return r.text().then(function (t) {
									return parseDevJsonText(t);
								});
							})
							.then(function (j) {
								if (j.ok) {
									alert(j.message || "已创建");
									postSlugInp.value = "";
									if (postTitleInp) postTitleInp.value = "";
									refreshPostList();
								} else alert(j.error || "创建失败");
							})
							.catch(function (e) {
								alert("创建请求失败：" + (e && e.message ? e.message : String(e)));
							});
					});
				}

				if (postDeleteBtn && postDeleteSelect) {
					postDeleteBtn.addEventListener("click", function () {
						var p = postDeleteSelect.value;
						if (!p) {
							alert("请先在下方列表里选择要删除的文件");
							return;
						}
						if (!confirm("确定删除 src/content/posts/" + p + " ？此操作不可恢复。")) return;
						fetch(fireflyUrl("post-delete/"), {
							method: "POST",
							headers: { "Content-Type": "application/json" },
							body: JSON.stringify({ path: p }),
						})
							.then(function (r) {
								return r.text().then(function (t) {
									return parseDevJsonText(t);
								});
							})
							.then(function (j) {
								if (j.ok) {
									alert(j.message || "已删除");
									refreshPostList();
								} else alert(j.error || "删除失败");
							})
							.catch(function (e) {
								alert("删除请求失败：" + (e && e.message ? e.message : String(e)));
							});
					});
				}

				if (postRefreshBtn) {
					postRefreshBtn.addEventListener("click", function () {
						refreshPostList();
					});
				}

				function onSwupNav() {
					syncPathFromUrl();
					if (!panel.classList.contains("hidden")) renderPaths();
					refreshInlineAnnounceAfterNav();
				}
				document.addEventListener("swup:contentReplaced", onSwupNav);
				document.addEventListener("swup:content:replace", onSwupNav);

				try {
					hl.checked = sessionStorage.getItem(STORAGE_HIGHLIGHT) === "1";
					applyHighlight(hl.checked);
				} catch (e) {}
				try {
					if (inlineAnnounce) {
						inlineAnnounce.checked = sessionStorage.getItem(STORAGE_INLINE_ANNOUNCE) === "1";
						if (inlineAnnounce.checked) applyInlineAnnounce(true);
					}
				} catch (e) {}
				loadLayout();
			})();
		</script>
	)
}
