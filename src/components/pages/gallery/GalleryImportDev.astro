---
/**
 * 仅开发环境：相册导入 +（列表页）新建相册。
 * 由 src/middleware.ts 转发至 firefly-dev-api（URL 须带尾斜杠以配合 astro trailingSlash: "always"）。
 */
import { galleryConfig } from "@/config";

interface Props {
	/** 相册详情页传入，用于固定上传目标；此模式下隐藏「新建相册」 */
	fixedAlbumId?: string;
}

const { fixedAlbumId } = Astro.props;
const isDev = import.meta.env.DEV;
const baseTrim = import.meta.env.BASE_URL.replace(/\/+$/, "");
const fireflyApiPrefix = `${baseTrim}/__firefly/`;
const albums = galleryConfig.albums;
const showCreateAlbum = !fixedAlbumId;
---

{
	isDev && (
		<div
			class:list={["mb-5", "grid", "gap-4", { "lg:grid-cols-2": showCreateAlbum }]}
			data-gallery-dev-tools
		>
			<details
				class="rounded-xl border border-dashed border-(--primary)/35 bg-(--btn-regular-bg)/40 px-4 py-3 text-sm dark:bg-neutral-900/40"
				data-gallery-import-dev
				data-fixed-album-id={fixedAlbumId ?? ""}
			>
				<summary class="cursor-pointer select-none font-medium text-(--primary) hover:opacity-90">
					导入更多图片（仅本地 dev）
				</summary>
				<div class="mt-3 space-y-3 text-neutral-600 dark:text-neutral-400">
					<p class="leading-relaxed">
						将图片保存到{" "}
						<code class="rounded bg-neutral-200/80 px-1 py-0.5 text-xs dark:bg-neutral-800">
							public/gallery/&lt;相册 id&gt;/
						</code>
						，刷新页面即可看到。需先运行 <code class="text-xs">pnpm dev</code>；生产静态站无此接口。
					</p>
					{fixedAlbumId ? (
						<p class="text-xs">
							当前相册 ID：<strong class="text-neutral-800 dark:text-neutral-200">{fixedAlbumId}</strong>
						</p>
					) : albums.length > 0 ? (
						<label class="flex flex-col gap-1">
							<span class="text-xs font-medium text-neutral-700 dark:text-neutral-300">选择相册</span>
							<select
								id="gallery-import-album"
								class="rounded-lg border border-(--line) bg-(--card-bg) px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100"
							>
								{albums.map((a) => (
									<option value={a.id}>
										{a.name}（{a.id}）
									</option>
								))}
							</select>
						</label>
					) : (
						<p class="text-xs text-amber-700 dark:text-amber-400">
							暂无相册：可用右侧「新建相册」，或手动编辑{" "}
							<code class="text-xs">src/config/galleryConfig.ts</code>。
						</p>
					)}
					<div
						id="gallery-import-drop"
						class="flex min-h-[4.5rem] cursor-pointer flex-col items-center justify-center rounded-lg border border-dashed border-(--line) bg-(--card-bg)/60 px-3 py-4 text-center text-xs transition-colors hover:border-(--primary)/50"
						tabindex="0"
						role="button"
					>
						<strong class="text-neutral-800 dark:text-neutral-200">拖到此处</strong>
						<span>或点击选择多张图片（jpg / png / webp / avif / gif）</span>
					</div>
					<input id="gallery-import-file" type="file" accept="image/*" multiple class="hidden" />
					<p id="gallery-import-status" class="min-h-[1.25rem] text-xs text-(--primary)" aria-live="polite" />
				</div>
			</details>

			{showCreateAlbum && (
				<details class="rounded-xl border border-dashed border-emerald-600/35 bg-(--btn-regular-bg)/40 px-4 py-3 text-sm dark:bg-neutral-900/40">
					<summary class="cursor-pointer select-none font-medium text-emerald-700 dark:text-emerald-400 hover:opacity-90">
						新建相册（仅本地 dev）
					</summary>
					<div class="mt-3 space-y-2.5 text-neutral-600 dark:text-neutral-400">
						<p class="text-xs leading-relaxed">
							会修改 <code class="rounded bg-neutral-200/80 px-1 py-0.5 dark:bg-neutral-800">src/config/galleryConfig.ts</code>{" "}
							并创建 <code class="text-xs">public/gallery/&lt;id&gt;/</code>。相册 id 建议英文+数字+连字符。
						</p>
						<label class="flex flex-col gap-0.5">
							<span class="text-xs font-medium text-neutral-700 dark:text-neutral-300">相册 id *</span>
							<input
								id="gallery-create-id"
								type="text"
								class="rounded-lg border border-(--line) bg-(--card-bg) px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100"
								placeholder="例如 my-trip-2026"
								autocomplete="off"
							/>
						</label>
						<label class="flex flex-col gap-0.5">
							<span class="text-xs font-medium text-neutral-700 dark:text-neutral-300">显示名称 *</span>
							<input
								id="gallery-create-name"
								type="text"
								class="rounded-lg border border-(--line) bg-(--card-bg) px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100"
								placeholder="相册标题"
								autocomplete="off"
							/>
						</label>
						<label class="flex flex-col gap-0.5">
							<span class="text-xs font-medium text-neutral-700 dark:text-neutral-300">描述（可选）</span>
							<textarea
								id="gallery-create-desc"
								class="min-h-[3rem] rounded-lg border border-(--line) bg-(--card-bg) px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100"
								placeholder="一句话介绍"
							/>
						</label>
						<label class="flex flex-col gap-0.5">
							<span class="text-xs font-medium text-neutral-700 dark:text-neutral-300">地点（可选）</span>
							<input
								id="gallery-create-loc"
								type="text"
								class="rounded-lg border border-(--line) bg-(--card-bg) px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100"
							/>
						</label>
						<label class="flex flex-col gap-0.5">
							<span class="text-xs font-medium text-neutral-700 dark:text-neutral-300">日期（可选）</span>
							<input
								id="gallery-create-date"
								type="date"
								class="rounded-lg border border-(--line) bg-(--card-bg) px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100"
							/>
						</label>
						<label class="flex flex-col gap-0.5">
							<span class="text-xs font-medium text-neutral-700 dark:text-neutral-300">标签（可选，逗号分隔）</span>
							<input
								id="gallery-create-tags"
								type="text"
								class="rounded-lg border border-(--line) bg-(--card-bg) px-3 py-2 text-sm text-neutral-900 dark:text-neutral-100"
								placeholder="旅行, 日常"
							/>
						</label>
						<button
							type="button"
							id="gallery-create-btn"
							class="mt-1 w-full rounded-lg bg-emerald-600 px-3 py-2 text-sm font-medium text-white hover:bg-emerald-700"
						>
							创建相册
						</button>
						<p id="gallery-create-status" class="min-h-[1.25rem] text-xs text-emerald-700 dark:text-emerald-400" aria-live="polite" />
					</div>
				</details>
			)}
		</div>
	)
}

{
	isDev && (
		<style is:global>
			#gallery-import-drop[data-dragging="1"] {
				outline: 2px dashed rgb(14 165 233 / 0.55);
				outline-offset: 3px;
			}
		</style>
		<script is:inline define:vars={{ fireflyApiPrefix }}>
			(function () {
				function fireflyUrl(subpath) {
					var p = String(subpath || "");
					if (p.charAt(0) === "/") p = p.slice(1);
					return fireflyApiPrefix + p;
				}
				var root = document.querySelector("[data-gallery-import-dev]");
				if (!root) return;
				var fixedAlbumId = root.getAttribute("data-fixed-album-id") || "";
				var drop = document.getElementById("gallery-import-drop");
				var fileInput = document.getElementById("gallery-import-file");
				var select = document.getElementById("gallery-import-album");
				var status = document.getElementById("gallery-import-status");
				if (!drop || !fileInput || !status) return;

				function albumId() {
					if (fixedAlbumId) return fixedAlbumId;
					if (select && select.value) return select.value;
					return "";
				}

				function upload(files) {
					var id = albumId();
					if (!id) {
						status.textContent = "请先选择相册或先新建相册。";
						return;
					}
					var list = Array.prototype.filter.call(files || [], function (f) {
						return f.type && f.type.indexOf("image/") === 0;
					});
					if (!list.length) {
						status.textContent = "没有可用的图片文件。";
						return;
					}
					status.textContent = "正在上传 " + list.length + " 张…";
					var fd = new FormData();
					fd.append("albumId", id);
					for (var i = 0; i < list.length; i++) fd.append("file", list[i]);
					fetch(fireflyUrl("gallery-upload/"), { method: "POST", body: fd })
						.then(function (res) {
							return res.json().then(function (data) {
								return { res: res, data: data };
							});
						})
						.then(function (o) {
							if (!o.res.ok || !o.data.ok) {
								status.textContent = (o.data && o.data.error) || "上传失败 HTTP " + o.res.status;
								return;
							}
							var n = o.data.saved && o.data.saved.length;
							status.textContent =
								"已写入 " +
								n +
								" 张，刷新本页即可预览。（路径：public/gallery/" +
								id +
								"/）";
						})
						.catch(function (e) {
							status.textContent = String((e && e.message) || e);
						});
				}

				drop.addEventListener("click", function () {
					fileInput.click();
				});
				drop.addEventListener("keydown", function (ev) {
					if (ev.key === "Enter" || ev.key === " ") {
						ev.preventDefault();
						fileInput.click();
					}
				});
				fileInput.addEventListener("change", function () {
					upload(fileInput.files);
					fileInput.value = "";
				});
				["dragenter", "dragover"].forEach(function (name) {
					drop.addEventListener(name, function (e) {
						e.preventDefault();
						e.stopPropagation();
						drop.setAttribute("data-dragging", "1");
					});
				});
				drop.addEventListener("dragleave", function (e) {
					e.preventDefault();
					e.stopPropagation();
					drop.removeAttribute("data-dragging");
				});
				drop.addEventListener("drop", function (e) {
					e.preventDefault();
					e.stopPropagation();
					drop.removeAttribute("data-dragging");
					var dt = e.dataTransfer;
					if (dt && dt.files && dt.files.length) upload(dt.files);
				});
			})();
		</script>
		<script is:inline define:vars={{ fireflyApiPrefix }}>
			(function () {
				function fireflyUrl(subpath) {
					var p = String(subpath || "");
					if (p.charAt(0) === "/") p = p.slice(1);
					return fireflyApiPrefix + p;
				}
				var btn = document.getElementById("gallery-create-btn");
				var st = document.getElementById("gallery-create-status");
				if (!btn || !st) return;
				btn.addEventListener("click", function () {
					var idEl = document.getElementById("gallery-create-id");
					var nameEl = document.getElementById("gallery-create-name");
					var descEl = document.getElementById("gallery-create-desc");
					var locEl = document.getElementById("gallery-create-loc");
					var dateEl = document.getElementById("gallery-create-date");
					var tagsEl = document.getElementById("gallery-create-tags");
					if (!idEl || !nameEl) return;
					var body = {
						id: idEl.value.trim(),
						name: nameEl.value.trim(),
						description: descEl ? descEl.value.trim() : "",
						location: locEl ? locEl.value.trim() : "",
						date: dateEl && dateEl.value ? dateEl.value.trim() : "",
						tags: tagsEl ? tagsEl.value.trim() : "",
					};
					st.textContent = "提交中…";
					fetch(fireflyUrl("gallery-create-album/"), {
						method: "POST",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify(body),
					})
						.then(function (res) {
							return res.json().then(function (data) {
								return { res: res, data: data };
							});
						})
						.then(function (o) {
							if (!o.res.ok || !o.data.ok) {
								st.textContent = (o.data && o.data.error) || "创建失败 HTTP " + o.res.status;
								return;
							}
							st.textContent = o.data.message || "已创建，请重启 dev 后刷新。";
						})
						.catch(function (e) {
							st.textContent = String((e && e.message) || e);
						});
				});
			})();
		</script>
	)
}
